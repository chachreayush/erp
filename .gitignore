# ──────────────────────────────────────────────────────────────
# .gitignore for ERP Software (Tauri + React + Python FastAPI)
# ──────────────────────────────────────────────────────────────

# ── Node / Frontend ──────────────────────────────────────────
node_modules/
dist/
.next/
.vite/
*.local

# ── Python / Backend ─────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.env
.venv
venv/
ENV/
env/
*.egg-info/
dist/
build/
*.spec

# ── Rust / Tauri ─────────────────────────────────────────────
target/
src-tauri/target/

# ── Database ─────────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

# ── Environment & Secrets ────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.key
*.pem

# ── OS Files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ───────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*

# ── Tauri Bundled Binaries (built artifacts) ─────────────────
src-tauri/binaries/*.exe
src-tauri/binaries/*.bin
